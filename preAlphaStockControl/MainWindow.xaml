<Window
    x:Class="preAlphaStockControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:preAlphaStockControl"
    mc:Ignorable="d"
    
    Title="PreAlphaStockControl"
    SizeToContent="WidthAndHeight" 
    Icon="/StockControl_Icon.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--BorderStyle-->
        <Style x:Key="NavigationItemBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--IconStyle-->
        <Style x:Key="NavigationIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!--TextBlockStyle-->
        <Style x:Key="NavigationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <!-- Header -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="0" 
                Margin="12">
                <TextBlock
                    Margin="0,10,10,10"
                    Text="StockControl"
                    FontSize="20"
                    FontWeight="Bold"
                    />
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition 
                                Width="Auto"/>
                            <ColumnDefinition 
                                Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="0,0,10,0"
                            FontFamily="Segoe Fluent Icons"
                            Text="&#xE721;"
                            FontSize="16" 
                            VerticalAlignment="Center"/>

                        <TextBox
                            Width="150"
                            Grid.Column="1"
                            BorderThickness="0"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!--End of header-->
            <!--Navigation-->
            <StackPanel 
                Grid.Row="1"
                Margin="12">
                <Border    
                    Style="{StaticResource NavigationItemBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock
                            Style="{StaticResource NavigationIconStyle}"
                            Text="&#xE80F;"/>
                        
                        <TextBlock
                            Style="{StaticResource NavigationTextStyle}"
                            Text="Dashboard"/>
                    </Grid>
                </Border>
                <Border
                    Style="{StaticResource NavigationItemBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource NavigationIconStyle}"
                            Text="&#xF133;"/>

                        <TextBlock
                            Style="{StaticResource NavigationTextStyle}"
                            Text="Product"/>
                    </Grid>
                </Border>
                <Border    
                    Style="{StaticResource NavigationItemBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource NavigationIconStyle}"
                            Text="&#xE902;"/>

                        <TextBlock
                            Style="{StaticResource NavigationTextStyle}"
                            Text="Customers"/>
                    </Grid>
                </Border>
                <Border    
                    Style="{StaticResource NavigationItemBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource NavigationIconStyle}"
                            Text="&#xEFFF;"/>

                        <TextBlock
                            Style="{StaticResource NavigationTextStyle}"
                            Text="Reports"/>
                    </Grid>
                </Border>
                <Border    
                    Style="{StaticResource NavigationItemBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource NavigationIconStyle}"
                            Text="&#xE713;"/>

                        <TextBlock
                            Style="{StaticResource NavigationTextStyle}"
                            Text="Settings"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!--End of Navigation-->
        </Grid>
        <!-- End of Sidebar -->
        
        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Label VerticalAlignment="Center">
                Enter your first name:
            </Label>

            <TextBox Grid.Column="1"
                     x:Name="FirstName"
                     BorderThickness="0"
                     Margin="2" 
                     VerticalAlignment="Center"/>

            <Label Grid.Row="1"
                   VerticalAlignment="Center">
                Enter your last name:
            </Label>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     x:Name="LastName"
                     BorderThickness="0"
                     Margin="2" 
                     VerticalAlignment="Center"/>

            <Button Grid.Row="2"
                    x:Name="Reset"
                    Margin="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch">
                    Reset
            </Button>

            <Button Grid.Row="2"
                    Grid.Column="1"
                    x:Name="Submit"
                    Margin="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch" 
                    Click="Submit_Click"
                    Style="{DynamicResource AccentButtonStyle}">
                    Submit
            </Button>

        </Grid>
        <!-- Main Content -->
    </Grid>
</Window>