<Window
    x:Class="preAlphaStockControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:preAlphaStockControl"
    mc:Ignorable="d"
    
    Title="PreAlphaStockControl"
    Height="500"
    Width="1200"
    Icon="/StockControl_Icon.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style x:Key="NavigationItemBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Tag" Value="Search..."/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="4,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Root"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,0,4,0"
                                    FontFamily="Segoe Fluent Icons"
                                    Text="&#xE721;"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                    VerticalAlignment="Center"/>

                                <Grid Grid.Column="1">
                                    <TextBlock
                                        x:Name="Placeholder"
                                        Text="{TemplateBinding Tag}"
                                        Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed"/>

                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--IconStyle-->
        <Style x:Key="NavigationIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!--TextBlockStyle-->
        <Style x:Key="NavigationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <!-- Header -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="0" 
                Margin="12">
                <TextBox
                    x:Name="SearchBox"
                    Margin="8"
                    Style="{StaticResource SearchBoxStyle}"/>
            </StackPanel>
            <!--End of header-->
            <!--Navigation-->
            <ListView
                Grid.Row="1"
                x:Name="NavigationList"
                Margin="10"
                BorderThickness="0"
                SelectionMode="Single"
                SelectedIndex="0">

                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                Style="{StaticResource NavigationIconStyle}"
                Text="&#xE80F;"/>

                        <TextBlock
                Style="{StaticResource NavigationTextStyle}"
                Text="Dashboard"/>
                    </StackPanel>
                </ListViewItem>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                Style="{StaticResource NavigationIconStyle}"
                Text="&#xEA38;"/>

                        <TextBlock
                Style="{StaticResource NavigationTextStyle}"
                Text="Products"/>
                    </StackPanel>
                </ListViewItem>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                Style="{StaticResource NavigationIconStyle}"
                Text="&#xE716;"/>

                        <TextBlock
                Style="{StaticResource NavigationTextStyle}"
                Text="Customers"/>
                    </StackPanel>
                </ListViewItem>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                Style="{StaticResource NavigationIconStyle}"
                Text="&#xE9F9;"/>

                        <TextBlock
                Style="{StaticResource NavigationTextStyle}"
                Text="Reports"/>
                    </StackPanel>
                </ListViewItem>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                Style="{StaticResource NavigationIconStyle}"
                Text="&#xE713;"/>

                        <TextBlock
                Style="{StaticResource NavigationTextStyle}"
                Text="Settings"/>
                    </StackPanel>
                </ListViewItem>

            </ListView>
            <!--End of Navigation-->
            <!-- Footer -->        
            <StackPanel 
                Grid.Row="2"
                Margin="12">
                <ComboBox 
                    x:Name="Change_ThemeMode" 
                    MinWidth="200" 
                    HorizontalAlignment="Left" 
                    SelectedIndex="2"
                    AutomationProperties.Name="Change ThemeMode" 
                    SelectionChanged="ThemeMode_SelectionChanged" 
                    Margin="10">
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Use system setting" />
                </ComboBox>
                
                <TextBlock
                    Text="© 2026 StockControl. All rights reserved."
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="Gray"
                    Margin="12"/>
            </StackPanel>
        </Grid>
        <!-- End of Sidebar -->
        
        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Label VerticalAlignment="Center">
                Enter your first name:
            </Label>

            <TextBox Grid.Column="1"
                     x:Name="FirstName"
                     BorderThickness="0"
                     Margin="2" 
                     VerticalAlignment="Center"/>

            <Label Grid.Row="1"
                   VerticalAlignment="Center">
                Enter your last name:
            </Label>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     x:Name="LastName"
                     BorderThickness="0"
                     Margin="2" 
                     VerticalAlignment="Center"/>

            <Button Grid.Row="2"
                    x:Name="Reset"
                    Margin="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch">
                    Reset
            </Button>

            <Button Grid.Row="2"
                    Grid.Column="1"
                    x:Name="Submit"
                    Margin="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch" 
                    Click="Submit_Click"
                    Style="{DynamicResource AccentButtonStyle}">
                    Submit
            </Button>

        </Grid>
        <!-- Main Content -->
    </Grid>
</Window>